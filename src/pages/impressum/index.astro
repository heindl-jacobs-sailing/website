---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Impressum" description="Impressum von Heindl/Jacobs Sailing — Angaben gemäß § 5 TMG.">
  <section class="intro-section">
    <div class="section-header center">
      <span class="pre-title">RECHTLICHES</span>
      <h2>Impressum</h2>
      <p>Angaben gemäß § 5 TMG</p>
    </div>

    <div class="legal-card">
      <div class="legal-grid">
        <div class="legal-block">
          <h3>
            <svg class="legal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s7-6.2 7-11.6A7 7 0 0 0 5 9.4C5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.4" r="2.4"/></svg>
            Anbieter
          </h3>
          <p>
            Heindl.Jacobs.Sailing<br />
            Hamburger Chaussee 13<br />
            24114 Kiel
          </p>
        </div>

        <div class="legal-block">
          <h3>
            <svg class="legal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5c0 8.3 6.7 15 15 15l1-4-5-2-2 2c-2.2-1.1-4-2.9-5-5l2-2-2-5-4 1Z"/></svg>
            Telefon
          </h3>
          <p><a href="tel:+491575963608">01575 9636086</a></p>
        </div>

        <div class="legal-block">
          <h3>
            <svg class="legal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 6.5 8 6.5 8-6.5"/></svg>
            E-Mail
          </h3>
          <p><a href="mailto:heindl.jacobs.sailing@gmail.com">heindl.jacobs.sailing@gmail.com</a></p>
        </div>
      </div>

      <div class="legal-footer">
        <p>© Urheberrecht. Alle Rechte vorbehalten.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-card {
    max-width: 900px;
    margin: 60px auto 0;
    background-color: var(--bg-card);
    border: 1px solid #333;
    border-radius: 12px;
    padding: 50px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .legal-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.3fr;
    gap: 40px;
  }

  .legal-block h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--neon-volt);
    letter-spacing: 1px;
    margin: 0 0 14px 0;
  }

  .legal-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .legal-block p {
    color: var(--text-white);
    line-height: 1.7;
    margin: 0;
  }

  .legal-block a {
    color: var(--text-white);
    text-decoration: none;
    border-bottom: 1px solid #444;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .legal-block a:hover {
    color: var(--neon-volt);
    border-color: var(--neon-volt);
  }

  .legal-footer {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid #333;
  }
  .legal-footer p {
    margin: 0;
    color: var(--text-gray);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .legal-card { padding: 30px; }
    .legal-grid { grid-template-columns: 1fr; gap: 30px; }
  }
</style>
