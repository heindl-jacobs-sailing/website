---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const timelineAll = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order);
// Preview: die 3 zentralen Punkte (Gründung-Highlight, aktueller Stand, großes Ziel)
const preview = [
  timelineAll.find((e) => e.data.order === 7), // GOLD! U23/U21 - Oktober 2025
  timelineAll.find((e) => e.data.order === 9), // WM Quiberon - Mai 2026 (JETZT)
  timelineAll.find((e) => e.data.order === 13), // LA 2028
].filter(Boolean);

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const sponsors = (await getCollection('sponsors')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Startseite">
  <section class="hero-section">
    <div class="hero-bg">
      <img src={`${base}images/hero.jpg`} alt="49er Sailing Action" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge"></div>
      <h1>HEINDL &amp;<br /><span class="neon-text">JACOBS</span></h1>
      <p class="hero-lead">Zwei Athleten. Ein Skiff. Die Mission: Olympische Spiele LA 2028.</p>
      <div class="hero-btns">
        <a href={`${base}road-to-gold/`} class="btn-main">Kampagne entdecken</a>
        <a href={`${base}partner/`} class="btn-outline">Partner werden</a>
      </div>
    </div>
  </section>

  <section class="ticker-section">
    <div class="ticker-item">
      <span class="t-num">25+</span>
      <span class="t-desc">Knoten Topspeed</span>
    </div>
    <div class="ticker-item">
      <span class="t-num">59,2 m²</span>
      <span class="t-desc">Segelfläche</span>
    </div>
    <div class="ticker-item">
      <span class="t-num">100%</span>
      <span class="t-desc">Fokus auf LA 2028</span>
    </div>
  </section>

  <section class="intro-section">
    <div class="intro-grid">
      <div class="intro-text">
        <span class="pre-title">DIE MISSION</span>
        <h2>LEISTUNG ALS<br />MASSSTAB</h2>
        <p>
          Wir sind Simon Heindl und Conrad Jacobs, U21 Weltmeister und Nationalsegler im 49er. Unser
          Fokus liegt klar auf den Olympischen Spielen 2028. Als Studenten in den Bereichen Wirtschaft
          und Psychologie sowie als Sportsoldat verbinden wir akademische Methodik mit absolutem
          High-Performance-Sport.
        </p>
        <p>
          Wir bieten Unternehmen eine exklusive, internationale Plattform, um Werte wie Dynamik,
          Präzision und außergewöhnlichen Teamgeist für die eigene Marke zu besetzen.
        </p>
        <a href={`${base}partner/`} class="text-link">Zu den Sponsoring-Paketen →</a>
      </div>
      <a href="#boat-section" class="visual-box">
        <img src={`${base}images/boat.jpg`} alt="Ausrüstung" loading="lazy" />
        <div class="caption">High-Tech Ausrüstung (Details ansehen)</div>
      </a>
    </div>
  </section>

  <section class="crew-section">
    <div class="section-header center">
      <span class="pre-title">DIE CREW</span>
      <h2>SYNERGIE AUF<br />DEM WASSER</h2>
      <p>Segeln im 49er ist wie Schach bei 40 km/h auf einer instabilen Plattform.</p>
    </div>
    <div class="crew-grid">
      {team.map((member) => (
        <button
          type="button"
          class="crew-card"
          data-name={member.data.name}
          data-role={member.data.role}
          data-photo={`${base}${member.data.photo.replace(/^\//, '')}`}
          data-bio={member.body}
          data-height={member.data.height}
          data-weight={member.data.weight}
          data-sailing={member.data.sailingSince}
          data-education={member.data.education}
        >
          <div class="crew-img" style={`background-image: url(${base}${member.data.photo.replace(/^\//, '')})`}></div>
          <div class="crew-info">
            <h3>{member.data.name}</h3>
            <span class="crew-role">{member.data.role}</span>
            <p set:html={member.body} />
            <span class="crew-more">Mehr erfahren →</span>
          </div>
        </button>
      ))}
    </div>
  </section>

  <div class="crew-modal-overlay" id="crew-modal-overlay">
    <div class="crew-modal" role="dialog" aria-modal="true">
      <button type="button" class="crew-modal-close" id="crew-modal-close" aria-label="Schließen">✕</button>
      <div class="crew-modal-img" id="crew-modal-img"></div>
      <div class="crew-modal-body">
        <h3 id="crew-modal-name"></h3>
        <span class="crew-role" id="crew-modal-role"></span>
        <p id="crew-modal-bio"></p>
        <div class="crew-stats" id="crew-modal-stats"></div>
      </div>
    </div>
  </div>

  <section class="timeline-preview">
    <div class="section-header center">
      <span class="pre-title">MEILENSTEINE</span>
      <h2>UNSER WEG<br />ZUR WELTSPITZE</h2>
    </div>
    <div class="tl-preview-grid">
      {preview.map((entry) => (
        <a
          href={`${base}road-to-gold/`}
          class={`tl-preview-card ${entry!.data.highlight ? 'highlight-card' : ''} ${entry!.data.future ? 'future-card' : ''}`}
        >
          <span class={`tl-date ${entry!.data.olympic ? 'is-olympic' : ''}`}>{entry!.data.date}</span>
          <h4>{entry!.data.title}</h4>
        </a>
      ))}
    </div>
    <div class="center-btn" style="margin-top: 40px; text-align: center;">
      <a href={`${base}road-to-gold/`} class="btn-outline">Komplette Timeline ansehen</a>
    </div>
  </section>

  <section id="boat-section" class="boat-section">
    <div class="section-header center">
      <span class="pre-title">HIGH-TECH SKIFF</span>
      <h2>FORMEL 1 <span class="neon-text">AUF DEM WASSER</span></h2>
    </div>
    <div class="boat-tech-layout">
      <div class="boat-tech-visual">
        <img src={`${base}images/skiff.jpg`} alt="49er Skiff" loading="lazy" />
      </div>
      <div class="boat-tech-grid-compact">
        <div class="tech-card-compact"><span class="t-num-small">1</span><span><strong>Mast:</strong> 8,50m Carbon</span></div>
        <div class="tech-card-compact"><span class="t-num-small">2</span><span><strong>Groß:</strong> 16,1 m²</span></div>
        <div class="tech-card-compact"><span class="t-num-small">3</span><span><strong>Fock:</strong> 5,1 m²</span></div>
        <div class="tech-card-compact"><span class="t-num-small">4</span><span><strong>Gennaker:</strong> 38,0 m²</span></div>
        <div class="tech-card-compact"><span class="t-num-small">5</span><span><strong>Optimalgewicht:</strong> 165kg</span></div>
        <div class="tech-card-compact"><span class="t-num-small">6</span><span><strong>Breite:</strong> 2,74m (Wings)</span></div>
        <div class="tech-card-compact"><span class="t-num-small">7</span><span><strong>Pinnenausleger:</strong> Carbon 2,50m</span></div>
        <div class="tech-card-compact"><span class="t-num-small">8</span><span><strong>Rumpf:</strong> 4,99m L / 94kg</span></div>
        <div class="tech-card-compact"><span class="t-num-small">9</span><span><strong>Tiefgang:</strong> ca 1,45m (Schwert)</span></div>
      </div>
    </div>
  </section>

  <section class="cta-partner">
    <div class="cta-inner">
      <h2>WERDEN SIE TEIL DER MISSION</h2>
      <p>
        Spitzensport auf olympischem Niveau ist nur mit starken Partnern möglich. Werden Sie Teil
        unserer Reise nach Los Angeles und Brisbane.
      </p>
      <a href={`${base}partner/`} class="btn-main btn-large">Sponsoring-Pakete ansehen</a>
    </div>
  </section>

  <section class="partner-section">
    <div class="section-header center">
      <h2>Partner</h2>
    </div>
    <div class="partner-grid">
      {sponsors.map((sponsor) => (
        <div class="partner-logo">
          <img src={`${base}${sponsor.data.logo.replace(/^\//, '')}`} alt={sponsor.data.name} loading="lazy" />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const overlay = document.getElementById('crew-modal-overlay');
  const closeBtn = document.getElementById('crew-modal-close');
  const modalImg = document.getElementById('crew-modal-img');
  const modalName = document.getElementById('crew-modal-name');
  const modalRole = document.getElementById('crew-modal-role');
  const modalBio = document.getElementById('crew-modal-bio');
  const modalStats = document.getElementById('crew-modal-stats');

  function statBlock(label: string, value: string | null) {
    if (!value) return '';
    return `<div><span class="crew-stat-label">${label}</span><span class="crew-stat-value">${value}</span></div>`;
  }

  function openModal(card: HTMLElement) {
    const { name, role, photo, bio, height, weight, sailing, education } = card.dataset;
    if (modalImg) modalImg.style.backgroundImage = `url(${photo})`;
    if (modalName) modalName.textContent = name ?? '';
    if (modalRole) modalRole.textContent = role ?? '';
    if (modalBio) modalBio.textContent = (bio ?? '').trim();
    if (modalStats) {
      modalStats.innerHTML =
        statBlock('Größe', height ?? null) +
        statBlock('Gewicht', weight ?? null) +
        statBlock('Segelt seit', sailing ?? null) +
        statBlock('Ausbildung', education ?? null);
    }
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('.crew-card').forEach((card) => {
    card.addEventListener('click', () => openModal(card));
  });
  closeBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
